<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/panel_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_panel"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/panel_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.12"
        android:textAllCaps="true"
        android:textColor="@color/jarvis_cyan"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/panel_transcript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/jarvis_text_dim"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/panel_reply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="8"
        android:ellipsize="end"
        android:textColor="@color/jarvis_text"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/panel_confirm_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/panel_confirm_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/jarvis_amber"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/panel_btn_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_secondary"
                android:minHeight="48dp"
                android:stateListAnimator="@null"
                android:text="@string/panel_cancel"
                android:textAllCaps="false"
                android:textColor="@color/jarvis_text" />

            <Button
                android:id="@+id/panel_btn_confirm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:minHeight="48dp"
                android:stateListAnimator="@null"
                android:text="@string/panel_confirm"
                android:textAllCaps="false"
                android:textColor="@color/jarvis_bg"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
